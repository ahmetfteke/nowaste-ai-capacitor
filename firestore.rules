rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper function to check if user owns the document being created
    function isCreatingOwn() {
      return isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // Household helper: check if user is a member of the household
    function isHouseholdMember(householdId) {
      return isAuthenticated()
        && request.auth.uid in
          get(/databases/$(database)/documents/households/$(householdId)).data.memberIds;
    }

    // Household helper: check if user can write (owner or member, not viewer)
    function canWriteHousehold(householdId) {
      let role = get(/databases/$(database)/documents/households/$(householdId)).data.roles[request.auth.uid];
      return isAuthenticated() && (role == "owner" || role == "member");
    }

    // Dual-path read: user owns doc OR is household member
    function canReadShared() {
      return isAuthenticated()
        && (resource.data.userId == request.auth.uid
            || (resource.data.keys().hasAny(['householdId'])
                && resource.data.householdId != null
                && isHouseholdMember(resource.data.householdId)));
    }

    // Dual-path write on existing doc: user owns doc OR can write to household
    function canWriteShared() {
      return isAuthenticated()
        && (resource.data.userId == request.auth.uid
            || (resource.data.keys().hasAny(['householdId'])
                && resource.data.householdId != null
                && canWriteHousehold(resource.data.householdId)));
    }

    // Dual-path create: user creating own AND (no household OR can write to household)
    function canCreateShared() {
      return isCreatingOwn()
        && (!request.resource.data.keys().hasAny(['householdId'])
            || request.resource.data.householdId == null
            || canWriteHousehold(request.resource.data.householdId));
    }

    // Users collection
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    // Households collection
    match /households/{householdId} {
      // Members can read their household
      allow read: if isHouseholdMember(householdId);
      // Authenticated users can create (they become owner)
      allow create: if isAuthenticated()
        && request.resource.data.ownerId == request.auth.uid;
      // Members can update (role checks in Cloud Functions)
      allow update: if isHouseholdMember(householdId);
      // Only owner can delete, and only if sole member
      allow delete: if isAuthenticated()
        && resource.data.ownerId == request.auth.uid
        && resource.data.memberIds.size() == 1;
    }

    // Storage Spaces collection
    match /storageSpaces/{spaceId} {
      allow read: if canReadShared();
      allow create: if canCreateShared();
      allow update: if canWriteShared();
      allow delete: if canWriteShared();
    }

    // Food Items collection
    match /foodItems/{itemId} {
      allow read: if canReadShared();
      allow create: if canCreateShared();
      allow update: if canWriteShared();
      allow delete: if canWriteShared();
    }

    // Alerts collection
    match /alerts/{alertId} {
      allow read: if canReadShared();
      allow create: if canCreateShared();
      allow update: if canWriteShared();
      allow delete: if canWriteShared();
    }

    // Notification Settings collection (personal, not shared)
    match /notificationSettings/{settingId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isCreatingOwn();
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // User Settings collection (personal, not shared)
    match /userSettings/{settingId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isCreatingOwn();
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Captures collection (for AI processing)
    match /captures/{captureId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isCreatingOwn();
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Shopping List collection
    match /shoppingList/{itemId} {
      allow read: if canReadShared();
      allow create: if canCreateShared();
      allow update: if canWriteShared();
      allow delete: if canWriteShared();
    }

    // Usage tracking collection (for free tier limits, personal)
    match /usage/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
    }

    // Recipes collection
    match /recipes/{recipeId} {
      allow read: if canReadShared();
      allow create: if canCreateShared();
      allow update: if canWriteShared();
      allow delete: if canWriteShared();
    }

    // Recipe Usage tracking (for monthly limits, personal)
    match /recipeUsage/{usageId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isCreatingOwn();
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Community Suggestions (Feedback System)
    match /suggestions/{suggestionId} {
      // Anyone authenticated can read all suggestions (community-wide)
      allow read: if isAuthenticated();

      // Only creator can create (with their userId)
      allow create: if isCreatingOwn();

      // Anyone authenticated can update upvotes/upvoters (for voting) or commentCount
      allow update: if isAuthenticated()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['upvotes', 'upvoters', 'commentCount']);

      // Only creator can delete their own suggestion
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;

      // Comments subcollection
      match /comments/{commentId} {
        // Anyone authenticated can read comments
        allow read: if isAuthenticated();

        // Anyone authenticated can create comments (with their userId)
        allow create: if isAuthenticated()
          && request.resource.data.userId == request.auth.uid;

        // Only comment owner can delete their comment
        allow delete: if isAuthenticated()
          && resource.data.userId == request.auth.uid;
      }
    }
  }
}
